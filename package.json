{
  "name": "qq-life",
  "version": "1.6.0",
  "description": "DSH 原生 QQ 群友情绪、关系与长期记忆插件，适配 qq-bridge 二代模式",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jujku/dsh-qq-life.git"
  },
  "homepage": "https://github.com/jujku/dsh-qq-life#readme",
  "bugs": {
    "url": "https://github.com/jujku/dsh-qq-life/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq-bridge",
    "emotion",
    "memory"
  ],
  "files": [
    "*.js",
    "panel.html",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "scripts/install.mjs",
    "scripts/check-release.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.mjs",
    "check": "node scripts/check-release.mjs",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
